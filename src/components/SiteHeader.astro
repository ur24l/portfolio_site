---
import profile from "../data/profile.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="site-header">
  <div class="wrap">
    <a class="site-name" href={`${base}/`}>
      {profile.name}
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href={`${base}/#work`}>Work</a>
      <a href={`${base}/#experience`}>Experience</a>
      <a href={`${base}/#skills`}>Skills</a>
      <a href={`${base}/resume/`}>Resume</a>
      <a class="nav-cta" href={`${base}/#contact`}>
        Get in touch
      </a>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch theme"
        title="Switch between light and dark"
      >
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Light/dark switch: remembers the visitor's choice on this device.
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const updateLabel = () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    toggle?.setAttribute("aria-label", `Switch to ${next} theme`);
  };
  updateLabel();
  toggle?.addEventListener("click", () => {
    const theme = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // Storage can be blocked; the switch still works for this visit.
    }
    updateLabel();
  });
</script>
