---
interface Props {
  type: string;
}
const { type } = Astro.props;
---

<div class:list={["project-visual", `visual-${type}`]} aria-hidden="true">
  {type === "attendance" && (
    <>
      <div class="visual-grid"></div>
      <div class="att-kiosk">
        <div class="window-bar">
          <span>
            <i></i>
            <i></i>
            <i></i>
          </span>
          <small>face-attendance-pipeline</small>
        </div>
        <div class="att-body">
          <div class="att-scan">
            <span class="att-corner att-tl"></span>
            <span class="att-corner att-tr"></span>
            <span class="att-corner att-bl"></span>
            <span class="att-corner att-br"></span>
            <svg viewBox="0 0 100 100" class="att-person">
              <circle cx="50" cy="38" r="16"></circle>
              <path d="M20 90c4-19 16-28 30-28s26 9 30 28"></path>
            </svg>
          </div>
          <div class="att-messages">
            <span class="att-msg att-warn">Quality gate: low light rejected</span>
            <span class="att-msg att-bad">MiniFASNet: spoof blocked</span>
            <span class="att-msg att-ok">SFace + pgvector: verified 09:28</span>
          </div>
        </div>
      </div>
      <span class="visual-caption">ARCHITECTURE ILLUSTRATION · ON-PREMISES</span>
    </>
  )}
  {type === "news" && (
    <>
      <div class="visual-grid"></div>
      <div class="news-window">
        <div class="window-bar">
          <span>
            <i></i>
            <i></i>
            <i></i>
          </span>
          <small>n8n-daily-digest.json</small>
        </div>
        <div class="news-body">
          <div class="news-date">
            <span>09:00 IST SCHEDULE</span>
            <span>4 RSS FEEDS → GROQ LLM</span>
          </div>
          <div class="news-story">
            <b>9.0</b>
            <div>
              <strong>AI & Large Language Models</strong>
              <span>Deduplicated · Structured JSON</span>
            </div>
          </div>
          <div class="news-story">
            <b>8.2</b>
            <div>
              <strong>Semiconductors & Systems</strong>
              <span>GPT OSS 120B → 20B fallback</span>
            </div>
          </div>
          <div class="news-bottom">
            <span>8–12 ranked summaries</span>
            <span>HTML Email</span>
          </div>
        </div>
      </div>
      <span class="visual-caption">WORKFLOW PIPELINE · N8N</span>
    </>
  )}
  {type === "crm" && (
    <>
      <div class="visual-grid"></div>
      <div class="crm-overview">
        <div class="flow-mini">
          <span>01</span>
          <b>Website Form</b>
          <small>Webhook payload ingestion</small>
        </div>
        <div class="flow-connector">
          <i></i>
        </div>
        <div class="flow-mini flow-accent">
          <span>02</span>
          <b>n8n Pipeline</b>
          <small>Sanitize · validate · map schema</small>
        </div>
        <div class="flow-connector">
          <i></i>
        </div>
        <div class="flow-mini">
          <span>03</span>
          <b>Odoo CRM</b>
          <small>Create lead + notify sales</small>
        </div>
      </div>
      <span class="visual-caption">INTEGRATION FLOW · IN PROGRESS</span>
    </>
  )}
  {type === "robot" && (
    <>
      <div class="visual-grid"></div>
      <div class="arch-stack">
        <div class="arch-node">React + MUI Client</div>
        <div class="arch-arrow">↕ REST API</div>
        <div class="arch-node arch-node-mid">Node.js + Express Server</div>
        <div class="arch-arrow">↕ Single-Table</div>
        <div class="arch-node">AWS DynamoDB</div>
      </div>
      <span class="visual-caption">FULL-STACK ARCHITECTURE</span>
    </>
  )}
  {type === "data" && (
    <>
      <div class="visual-grid"></div>
      <div class="data-model">
        <span>
          patients <b>PK id</b>
        </span>
        <i>↙ &nbsp; ↘</i>
        <div>
          <span>appointments</span>
          <span>billing</span>
        </div>
        <i>↓</i>
        <span class="model-result">SQL Reporting Views</span>
      </div>
      <span class="visual-caption">RELATIONAL DATA MODEL</span>
    </>
  )}
  {type === "vision" && (
    <>
      <div class="vision-grid"></div>
      <div class="track-box track-one">
        <span>ID #01</span>
      </div>
      <div class="track-box track-two">
        <span>ID #02</span>
      </div>
      <div class="count-line">
        <span>VIRTUAL COUNTING LINE</span>
      </div>
      <span class="vision-caption">detect → track → count</span>
      <span class="visual-caption">OPENCV TRACKING SCHEMATIC</span>
    </>
  )}
</div>
