---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import profile from "../data/profile.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Message sent · Bhargav Sai Bhartu"
  description="Your message has been sent to Bhargav Sai Bhartu."
>
  <SiteHeader />
  <main id="main">
    <section class="intro" aria-labelledby="thanks-title">
      <div class="wrap">
        <h1 id="thanks-title">Thank you for your message.</h1>
        <p class="lead">
          It has been delivered to{" "}
          <a href={`mailto:${profile.email}`}>{profile.email}</a>. I will reply
          as soon as I can.
        </p>
        <div class="actions">
          <a class="button" href={`${base}/`}>
            Back to the homepage
          </a>
          <a class="button secondary" href={`${base}/resume/`}>
            View resume
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
