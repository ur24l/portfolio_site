---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import "../styles/experience.css";
import profile from "../data/profile.json";
import { projects } from "../data/projects";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (file: string) => `${base}/assets/${file}`;
const cvPdf = asset("Bhargav-Sai-Bhartu-Resume.pdf");
const cvDocx = asset("Bhargav-Sai-Bhartu-Resume.docx");
---

<Layout>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top" aria-label="Bhargav Sai Bhartu home">
        <span class="brand-mark">
          B<span>.</span>
        </span>
        <span>
          Bhargav Sai Bhartu<small>Python & AI Developer</small>
        </span>
      </a>
      <nav id="navigation" aria-label="Main navigation">
        <a href="#work">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#demo">Demo</a>
        <a href="#about">About</a>
      </nav>
      <div class="header-tools">
        <button
          class="tool search-open"
          data-command-open
          aria-label="Open quick menu"
          title="Quick menu (Ctrl/Cmd K)"
        >
          <Icon name="search" size={18} />
        </button>
        <button class="tool" data-theme aria-label="Switch to dark theme">
          <Icon name="moon" size={18} />
        </button>
        <a class="header-resume" href={`${base}/resume/`}>
          Resume <Icon name="arrow" size={14} />
        </a>
        <button
          class="tool menu-toggle"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="navigation"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>
  </header>
  <main id="main">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="role-badge" data-reveal>
          <span class="status-dot"></span> Junior Software Developer · PHYTEC India
        </p>
        <h1 id="hero-title" aria-label={profile.name} data-reveal>
          Bhargav Sai
          <br />
          <span>Bhartu</span>
        </h1>
        <p class="hero-role" data-reveal>
          Python & AI Developer building computer vision and automation systems
        </p>
        <p class="hero-description" data-reveal>
          At PHYTEC India, I design and ship practical backend and AI software—from an
          on-premises face recognition attendance platform with liveness checks to
          LLM-powered news briefings and Odoo CRM webhook pipelines.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="button button-dark" href="#work">
            View Projects <Icon name="down" size={16} />
          </a>
          <a class="button button-outline" href={cvPdf} download>
            <Icon name="file" size={16} /> Download Resume
          </a>
        </div>
        <div class="hero-links" data-reveal>
          <a href={`${base}/resume/`}>
            Online Resume <Icon name="arrow" size={14} />
          </a>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <Icon name="arrow" size={14} />
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">
            GitHub <Icon name="arrow" size={14} />
          </a>
          <button data-recruiter-open>
            Quick Summary <Icon name="arrow" size={14} />
          </button>
        </div>
      </div>

      <aside class="hero-profile" aria-label="Engineering overview" data-reveal>
        <div class="spec-card">
          <div class="spec-head">
            <span class="mini-label">SYSTEMS SNAPSHOT</span>
            <span class="spec-loc">
              <Icon name="location" size={14} />
              Visakhapatnam, IN
            </span>
          </div>
          <dl class="spec-list">
            <div>
              <dt>Current Role</dt>
              <dd>Junior Software Developer · PHYTEC India</dd>
            </div>
            <div>
              <dt>Flagship Build</dt>
              <dd>
                Face Attendance AI — YuNet, MiniFASNet, SFace, FastAPI,
                PostgreSQL (pgvector), Docker, 91 pytest tests
              </dd>
            </div>
            <div>
              <dt>Automation</dt>
              <dd>n8n workflows · Groq LLM APIs · Odoo CRM webhooks</dd>
            </div>
            <div>
              <dt>Core Stack</dt>
              <dd>Python · FastAPI · OpenCV · PostgreSQL · MySQL · Git</dd>
            </div>
          </dl>
          <div class="spec-pipeline">
            <div class="spec-pipeline-head">
              <span>ATTENDANCE PIPELINE</span>
              <a href="#demo">Try simulation →</a>
            </div>
            <div class="spec-steps" aria-hidden="true">
              <span>01 Detect</span>
              <span>02 Quality</span>
              <span>03 Liveness</span>
              <span>04 Match</span>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <div class="focus-strip">
      <div class="wrap">
        <p>CORE STACK</p>
        <span>Python</span>
        <span>FastAPI</span>
        <span>OpenCV</span>
        <span>PostgreSQL + pgvector</span>
        <span>Docker</span>
        <span>n8n & LLM APIs</span>
        <span>Odoo CRM</span>
      </div>
    </div>

    <section class="section wrap" id="work" aria-labelledby="work-title">
      <div class="section-top" data-reveal>
        <div>
          <p class="eyebrow">SELECTED PROJECTS</p>
          <h2 id="work-title">
            Software built to solve
            <br />
            <span>real operational problems.</span>
          </h2>
        </div>
        <p class="section-description">
          Production systems and engineering projects across computer vision,
          workflow automation, and full-stack development. Open any card for
          architecture notes.
        </p>
      </div>
      <div class="filter-row">
        <div class="filters" role="group" aria-label="Filter projects">
          {["All work", "Data & vision", "Automation", "Full-stack"].map(
            (label, i) => (
              <button
                class:list={["filter", { "is-active": i === 0 }]}
                data-project-filter={i === 0 ? "all" : label}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                {label}
              </button>
            ),
          )}
        </div>
        <span class="project-count" aria-live="polite">
          <span data-project-count>{projects.length}</span> projects
        </span>
      </div>
      <div class="projects-grid">
        {projects.map((project) => (
          <article
            class:list={["project", { "project-wide": project.wide }]}
            data-category={project.category}
            data-reveal
            data-spotlight
          >
            <button
              class="project-preview"
              data-project-open={project.id}
              aria-label={`Read architecture notes for ${project.name}`}
            >
              <ProjectVisual type={project.visual} />
              <span class="project-number" aria-hidden="true">
                /{project.number}
              </span>
              <span class="project-open">
                <Icon name="arrow" size={16} />
              </span>
            </button>
            <div class="project-info">
              <div class="project-kicker">
                <span>{project.category}</span>
                <span
                  class:list={[
                    "project-status",
                    { "in-progress": project.id === "crm" },
                  ]}
                >
                  {project.status}
                </span>
              </div>
              <h3>
                <button class="project-title" data-project-open={project.id}>
                  {project.name}
                  <Icon name="arrow" size={18} />
                </button>
              </h3>
              <p>{project.summary}</p>
              <ul class="tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <button
                class="text-link case-link"
                data-project-open={project.id}
              >
                Read project notes <Icon name="chevron" size={15} />
              </button>
            </div>
          </article>
        ))}
      </div>
      <div class="section-bottom">
        <p>More code and experiments on GitHub.</p>
        <a
          class="text-link"
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/ur24l <Icon name="arrow" size={16} />
        </a>
      </div>
    </section>

    <section
      class="experience-section"
      id="experience"
      aria-labelledby="experience-title"
    >
      <div class="wrap">
        <div class="section-top" data-reveal>
          <div>
            <p class="eyebrow">WORK EXPERIENCE</p>
            <h2 id="experience-title">
              Where I build
              <br />
              <span>and ship production software.</span>
            </h2>
          </div>
          <p class="section-description">
            Backend, computer vision, and automation engineering at PHYTEC India,
            following a full-stack product engineering internship.
          </p>
        </div>
        <div class="experience-list">
          {profile.experience.map((job, i) => (
            <article class="experience" data-reveal>
              <div class="experience-meta">
                <span class:list={["employment-label", { current: i === 0 }]}>
                  {i === 0 ? "CURRENT ROLE" : "INTERNSHIP"}
                </span>
                <p>{job.dates}</p>
                <small>
                  {i === 0 ? "Visakhapatnam · Full-time" : "Remote"}
                </small>
              </div>
              <div class="experience-body">
                <div class="experience-title">
                  <div>
                    <h3>{job.title}</h3>
                    <p>{i === 0 ? "PHYTEC India" : "Superport-IT"}</p>
                  </div>
                  <span class="company-monogram" aria-hidden="true">
                    {i === 0 ? "P" : "S"}
                  </span>
                </div>
                <ul class="experience-points">
                  {job.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
                {i === 0 && (
                  <div class="current-build">
                    <Icon name="flow" size={20} />
                    <div>
                      <b>Production Highlight · Face Attendance AI</b>
                      <p>
                        Camera → Quality Gate → MiniFASNet Liveness → pgvector
                        Match → Live WebSocket HR Dashboard
                      </p>
                    </div>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section wrap" id="skills" aria-labelledby="skills-title">
      <div class="section-top" data-reveal>
        <div>
          <p class="eyebrow">SKILLS & TOOLING</p>
          <h2 id="skills-title">
            Technical stack
            <br />
            <span>and active learning.</span>
          </h2>
        </div>
        <p class="section-description">
          Organized by production usage, distinguishing day-to-day engineering
          tools from active learning areas.
        </p>
      </div>
      <div class="skill-cards">
        {profile.skillGroups.map((group, i) => (
          <article class="skill-card" data-reveal>
            <span class="skill-index">0{i + 1}</span>
            <h3>{group.title}</h3>
            <p>{group.note}</p>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="learning-focus" data-reveal>
        <span class="learning-icon">
          <Icon name="code" size={22} />
        </span>
        <div>
          <h3>Next engineering focus</h3>
          <p>
            Deploying face recognition models on embedded NPU boards (edge AI),
            building multi-step AI agent workflows, and deepening JavaScript
            proficiency.
          </p>
        </div>
        <span class="learning-pill">ROADMAP</span>
      </div>
    </section>

    <section class="lab-section" id="demo" aria-labelledby="lab-title">
      <div class="wrap">
        <div class="lab-intro">
          <div>
            <p class="eyebrow">INTERACTIVE PIPELINE DEMO</p>
            <h2 id="lab-title">
              Face check-in verification,
              <br />
              <span>step by step.</span>
            </h2>
          </div>
          <p>
            A deterministic browser simulation of the decision gates inside Face
            Attendance AI. No camera is accessed and no data is stored.
          </p>
        </div>
        <div class="workflow-lab" data-reveal>
          <div class="lab-toolbar">
            <span>
              <i class="status-dot"></i> face-check-in.pipeline
            </span>
            <span class="demo-label">LOCAL SIMULATION · NO CAMERA</span>
          </div>
          <div class="lab-main">
            <div class="lab-controls">
              <span class="mini-label">01 / SELECT SCENARIO</span>
              <label for="scenario">Input frame condition</label>
              <select id="scenario">
                <option value="valid">Enrolled employee, good light</option>
                <option value="dark">Enrolled employee, poor light</option>
                <option value="photo">Printed photo held to camera</option>
                <option value="unknown">Unregistered person</option>
              </select>
              <div class="sample-input">
                <span>
                  source <b data-sample="source">Entrance kiosk</b>
                </span>
                <span>
                  light <b data-sample="light">Good</b>
                </span>
                <span>
                  face <b data-sample="face">Live employee</b>
                </span>
              </div>
              <button class="button button-accent" id="run-workflow">
                <Icon name="play" size={16} /> Run Pipeline
              </button>
              <p class="lab-footnote">
                Simulates YuNet detection, quality thresholds, MiniFASNet
                liveness, and SFace matching.
              </p>
            </div>
            <div class="lab-canvas">
              <ol class="workflow-nodes">
                <li data-node="0">
                  <span class="node-icon">
                    <Icon name="search" />
                  </span>
                  <div>
                    <small>STAGE 01 · DETECT</small>
                    <b>Locate face & landmarks</b>
                  </div>
                  <span class="node-state">01</span>
                </li>
                <li data-node="1">
                  <span class="node-icon">
                    <Icon name="check" />
                  </span>
                  <div>
                    <small>STAGE 02 · QUALITY</small>
                    <b>Light, sharpness & pose</b>
                  </div>
                  <span class="node-state">02</span>
                </li>
                <li data-node="2">
                  <span class="node-icon">
                    <Icon name="spark" />
                  </span>
                  <div>
                    <small>STAGE 03 · LIVENESS</small>
                    <b>Anti-spoofing check</b>
                  </div>
                  <span class="node-state">03</span>
                </li>
                <li data-node="3">
                  <span class="node-icon">
                    <Icon name="grid" />
                  </span>
                  <div>
                    <small>STAGE 04 · MATCH</small>
                    <b>pgvector embedding lookup</b>
                  </div>
                  <span class="node-state">04</span>
                </li>
              </ol>
              <div class="lab-result" role="status" aria-live="polite">
                <span class="result-dot"></span>
                <p id="workflow-result">
                  Ready. Choose a scenario and run the pipeline.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap" id="about" aria-labelledby="about-title">
      <div class="about-grid">
        <div class="about-copy" data-reveal>
          <p class="eyebrow">ABOUT</p>
          <h2 id="about-title">
            Engineering reliable software
            <br />
            <span>for real-world teams.</span>
          </h2>
          <p>
            I am Bhargav Sai Bhartu, a Python and AI developer at PHYTEC India in
            Visakhapatnam. I focus on practical systems where computer vision,
            APIs, and workflow automation eliminate manual bottlenecks.
          </p>
          <p>
            From designing PostgreSQL schemas and FastAPI services to debugging
            anti-spoofing thresholds and maintaining Docker deployments, I take
            ownership across the full lifecycle—architecture, testing, and
            production operations.
          </p>
          <div class="about-contact">
            <a class="text-link" href={`mailto:${profile.email}`}>
              Get in touch <Icon name="arrow" size={16} />
            </a>
            <span>Telugu · English</span>
          </div>
        </div>
        <aside class="education-panel" data-reveal>
          <h3>Education & Achievements</h3>
          {profile.education.map((item) => (
            <div class="education-item">
              <span>{item.dates}</span>
              <h4>{item.degree}</h4>
              <p>{item.school}</p>
              <small>{item.detail}</small>
            </div>
          ))}
          <div class="milestone">
            <Icon name="spark" size={18} />
            <div>
              <b>1st Place · HACKAP Hackathon</b>
              <span>Andhra Pradesh · 2023</span>
            </div>
          </div>
          <div class="milestone">
            <Icon name="code" size={18} />
            <div>
              <b>LeRobot Worldwide Hackathon</b>
              <span>Participant · Hugging Face · 2025</span>
            </div>
          </div>
          <details class="more-milestones">
            <summary>
              Certifications & Leadership <span>+</span>
            </summary>
            <ul>
              <li>Full-Stack Development · Wipro</li>
              <li>Programming in Java · NPTEL</li>
              <li>Ethical Hacking Workshop · JNTU Kakinada</li>
              <li>NSS Coordinator · Community welfare events</li>
            </ul>
          </details>
        </aside>
      </div>
    </section>

    <section
      class="section wrap contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-left" data-reveal>
        <p class="eyebrow">CONTACT</p>
        <h2 id="contact-title">
          Let’s connect about
          <br />
          <span>engineering roles or projects.</span>
        </h2>
        <p class="contact-description">
          Open to Python, Backend, and Applied AI engineering opportunities and
          technical collaborations.
        </p>
        <div class="contact-email">
          <a href={`mailto:${profile.email}`}>
            {profile.email}
            <Icon name="arrow" size={20} />
          </a>
          <button data-copy-email aria-label="Copy email address" title="Copy email">
            <Icon name="copy" size={18} />
          </button>
        </div>
        <div class="contact-links">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <Icon name="arrow" size={15} />
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">
            GitHub <Icon name="arrow" size={15} />
          </a>
          <a href={`tel:${profile.phone.replace(/\s/g, "")}`}>
            {profile.phone} <Icon name="arrow" size={15} />
          </a>
        </div>

        <aside class="resume-card">
          <div class="resume-card-head">
            <span class="mini-label">RESUME · 1-PAGE A4</span>
            <Icon name="file" size={19} />
          </div>
          <h3>Resume & Credentials</h3>
          <p>
            Single-column ATS-ready resume covering experience at PHYTEC India,
            Face Attendance AI, technical stack, and education.
          </p>
          <div class="resume-card-actions">
            <a class="button button-dark" href={cvPdf} download>
              <Icon name="down" size={16} /> Download PDF
            </a>
            <a class="button button-outline" href={`${base}/resume/`}>
              View Online <Icon name="arrow" size={15} />
            </a>
          </div>
          <div class="resume-card-meta">
            <a href={cvDocx} download>
              Download Word (.docx) <Icon name="down" size={13} />
            </a>
            <span>Synced with profile</span>
          </div>
        </aside>
      </div>

      <div class="contact-form-card" data-reveal>
        <div class="form-card-head">
          <span class="mini-label">DIRECT INQUIRY</span>
          <Icon name="mail" size={18} />
        </div>
        <h3>Send a message</h3>
        <p class="form-card-sub">
          Share details about a role or project. Submissions go directly to{" "}
          {profile.email}.
        </p>
        <form
          id="contact-form"
          class="contact-form"
          data-endpoint={
            profile.contactWebhookUrl ||
            `https://formsubmit.co/ajax/${profile.email}`
          }
          data-is-webhook={profile.contactWebhookUrl ? "true" : "false"}
        >
          <input
            type="text"
            name="_honey"
            class="hp-field"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="form-row-two">
            <div class="field">
              <label for="contact-name">Name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
              />
            </div>
            <div class="field">
              <label for="contact-email">Email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
              />
            </div>
          </div>

          <div class="field">
            <label for="contact-topic">Subject</label>
            <select id="contact-topic" name="topic">
              <option value="Engineering Role / Hiring">
                Engineering Role / Hiring
              </option>
              <option value="Project / Technical Collaboration">
                Project / Technical Collaboration
              </option>
              <option value="Automation / AI Inquiry">
                Automation / AI Inquiry
              </option>
              <option value="General Message">General Message</option>
            </select>
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows={4}
              required
              placeholder="Share details about the role, project, or question..."
            ></textarea>
          </div>

          <p id="contact-error" class="form-error" role="alert" hidden></p>

          <button class="button button-dark form-submit" type="submit">
            Send Message <Icon name="arrow" size={16} />
          </button>
        </form>

        <div id="contact-success" class="form-success" hidden>
          <div class="form-success-icon" aria-hidden="true">
            <Icon name="check" size={22} />
          </div>
          <h4>Message sent — thank you</h4>
          <p id="contact-success-copy">
            Your message has been delivered to {profile.email}. I will review
            your note and reply shortly.
          </p>
          <button
            type="button"
            class="button button-outline"
            id="contact-reset"
          >
            Send another message
          </button>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer wrap">
    <span>
      © {new Date().getFullYear()} {profile.name}
    </span>
    <div>
      <button data-motion aria-pressed="false">
        Motion: on
      </button>
      <button data-command-open>
        Quick menu <kbd>Ctrl K</kbd>
      </button>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>

  <dialog id="project-dialog" class="project-dialog">
    <div class="dialog-head">
      <span class="mini-label">PROJECT ARCHITECTURE NOTES</span>
      <button class="share-project" data-copy-project-link>
        <Icon name="copy" size={15} /> Copy link
      </button>
      <button data-close-dialog aria-label="Close project details">
        <Icon name="close" />
      </button>
    </div>
    <div id="project-detail"></div>
  </dialog>

  <dialog
    id="recruiter-dialog"
    class="recruiter-dialog"
    aria-labelledby="recruiter-title"
  >
    <div class="dialog-head">
      <span class="mini-label">CANDIDATE OVERVIEW</span>
      <button data-close-dialog aria-label="Close overview">
        <Icon name="close" />
      </button>
    </div>
    <p class="eyebrow">PYTHON & AI DEVELOPER</p>
    <h2 id="recruiter-title">{profile.name}</h2>
    <p>{profile.summary}</p>
    <dl class="recruiter-facts">
      <div>
        <dt>Core Focus</dt>
        <dd>Python · FastAPI · Computer Vision · LLM Automation</dd>
      </div>
      <div>
        <dt>Experience</dt>
        <dd>
          Junior Software Developer · PHYTEC India; Full Stack Intern ·
          Superport-IT
        </dd>
      </div>
      <div>
        <dt>Flagship Project</dt>
        <dd>
