---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import profile from "../data/profile.json";
import { projects } from "../data/projects";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const cv = `${base}/assets/Bhargav-Sai-Bhartu-Resume.pdf`;
const featured = projects.find((p) => p.featured)!;
const others = projects.filter((p) => !p.featured);
const endpoint =
  profile.contactWebhookUrl || `https://formsubmit.co/ajax/${profile.email}`;
const current = profile.experience[0];

const glance = [
  ["Role", current.title],
  ["Company", current.org],
  ["Location", profile.location],
  ["Focus", "Computer vision, Python backends, workflow automation"],
  ["Recent work", "Face Attendance AI, deployed on-premises"],
  ["Education", "B.Tech, Information Technology (2024)"],
];

const numbers = [
  ["91", "automated tests guarding the attendance system"],
  ["4", "checks on every scan before attendance is recorded"],
  ["On-prem", "deployment, with face data kept on the company network"],
  ["1st", "place at the HACKAP Hackathon, 2023"],
];

const highlights = [
  [
    "Spoof resistant",
    "Rejects printed photos and phone screens before any face is matched.",
  ],
  [
    "Secure by default",
    "Role-based access, short-lived tokens, login limits and safe password resets.",
  ],
  [
    "Built to run",
    "Docker deployment with migrations, daily backups and a full test suite.",
  ],
];

const pipeline = [
  ["Capture", "Kiosk camera or phone"],
  ["Detect", "YuNet face detector"],
  ["Check quality", "Blur, lighting and head pose"],
  ["Liveness", "MiniFASNet anti-spoofing"],
  ["Match", "SFace embedding and vector search"],
];

// Simple line icons, one per project (24px grid, stroked with currentColor).
const icons: Record<string, string> = {
  news: '<path d="M4 5h13v14H6a2 2 0 0 1-2-2V5Z"/><path d="M17 9h3v8a2 2 0 0 1-2 2"/><path d="M8 9h5M8 13h5M8 16h3"/>',
  vision:
    '<circle cx="8" cy="8" r="2.5"/><circle cx="16" cy="8" r="2.5"/><path d="M3.5 18a4.5 4.5 0 0 1 9 0M11.5 18a4.5 4.5 0 0 1 9 0"/>',
  crm: '<path d="M4 6h10M4 12h7M4 18h4"/><path d="m15 15 3 3 3-3M18 18V9"/>',
  robot:
    '<rect x="5" y="8" width="14" height="10" rx="2"/><path d="M12 4v4M9 13h.01M15 13h.01M3 12v3M21 12v3"/>',
  healthcare:
    '<ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6"/><path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5"/>',
};
const fallbackIcon = '<rect x="4" y="4" width="16" height="16" rx="3"/>';
---

<Layout>
  <SiteHeader />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">{profile.headline} · PHYTEC India</p>
          <h1 id="hero-title">
            Building computer vision and <em>automation</em> that works in the
            real world.
          </h1>
          <p class="lead">
            I'm {profile.name}, a junior software developer in Bengaluru. I
            built a face recognition attendance system end to end, from the
            vision pipeline to the on-premises server, and I automate business
            workflows with n8n and Odoo CRM.
          </p>
          <div class="actions">
            <a class="button" href="#work">
              View selected work{" "}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
            <a class="button secondary" href={cv} download>
              Download resume
            </a>
          </div>
          <div class="social">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <a href={profile.github} target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn ↗
            </a>
          </div>
        </div>

        <aside class="card glance" aria-label="At a glance">
          <div class="glance-title">
            <span>At a glance</span>
            <span class="status">Currently at PHYTEC India</span>
          </div>
          <dl>
            {glance.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class="numbers" aria-label="Key numbers">
      <div class="wrap">
        <ul>
          {numbers.map(([value, label]) => (
            <li class="reveal">
              <strong>{value}</strong>
              <span>{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="work-title">Case study</h2>
          </div>
          <p>
            The project I'm proudest of: a system my colleagues use to check in
            at work, built and deployed by me.
          </p>
        </div>

        <article class="card case reveal" id={featured.id}>
          <div class="case-grid">
            <div class="case-copy">
              <div class="case-meta">
                <span class="badge">Featured</span>
                <span>{featured.context}</span>
              </div>
              <h3>{featured.name}</h3>
              <p class="summary">{featured.summary}</p>
              <ul class="points">
                {featured.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <ul class="tags" aria-label="Technologies">
                {featured.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>

            <figure class="case-visual">
              <svg
                class="diagram"
                viewBox="0 0 480 420"
                role="img"
                aria-labelledby="diagram-title"
              >
                <title id="diagram-title">
                  Check-in pipeline: capture, detect, check quality, liveness,
                  match against PostgreSQL with pgvector, then record attendance
                  and update the HR dashboard.
                </title>
                <line class="d-line" x1="145" y1="40" x2="145" y2="356" />
                {pipeline.map(([label, sub], i) => (
                  <g transform={`translate(20 ${16 + i * 66})`}>
                    <rect class="d-box" width="250" height="48" rx="8" />
                    <circle class="d-dot" cx="24" cy="24" r="11" />
                    <text class="d-num" x="24" y="28">
                      {i + 1}
                    </text>
                    <text class="d-label" x="46" y="21">
                      {label}
                    </text>
                    <text class="d-sub" x="46" y="37">
                      {sub}
                    </text>
                  </g>
                ))}
                <line class="d-line" x1="270" y1="304" x2="310" y2="304" />
                <g transform="translate(310 280)">
                  <rect class="d-box alt" width="150" height="48" rx="8" />
                  <text class="d-label" x="14" y="21">
                    PostgreSQL
                  </text>
                  <text class="d-sub" x="14" y="37">
                    pgvector search
                  </text>
                </g>
                <g transform="translate(20 346)">
                  <rect class="d-box strong" width="250" height="48" rx="8" />
                  <text class="d-label inv" x="18" y="21">
                    Attendance recorded
                  </text>
                  <text class="d-sub inv" x="18" y="37">
                    Check-in or check-out
                  </text>
                </g>
                <line class="d-line" x1="270" y1="370" x2="310" y2="370" />
                <g transform="translate(310 346)">
                  <rect class="d-box alt" width="150" height="48" rx="8" />
                  <text class="d-label" x="14" y="21">
                    HR dashboard
                  </text>
                  <text class="d-sub" x="14" y="37">
                    Live over WebSockets
                  </text>
                </g>
              </svg>
              <figcaption>
                Every scan passes four checks before attendance is recorded.
              </figcaption>
            </figure>
          </div>
          <div class="highlights">
            {highlights.map(([title, text]) => (
              <div>
                <h4>{title}</h4>
                <p>{text}</p>
              </div>
            ))}
          </div>
        </article>

        <h3 class="more-title">More projects</h3>
        <div class="project-grid">
          {others.map((project) => (
            <article class="card project reveal" id={project.id}>
              <div class="project-top">
                <span class="project-icon" aria-hidden="true">
                  <svg
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={icons[project.id] ?? fallbackIcon}
                  />
                </span>
                <span class="context">{project.context}</span>
              </div>
              <h3>{project.name}</h3>
              <p class="summary">{project.summary}</p>
              <details>
                <summary>How it works</summary>
                <ul>
                  {project.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </details>
              <ul class="tags" aria-label="Technologies">
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Experience</p>
            <h2 id="experience-title">Where I've worked</h2>
          </div>
          <p>
            From building CRM features as an intern to shipping a production
            system at PHYTEC India.
          </p>
        </div>
        <ol class="timeline">
          {profile.experience.map((job) => (
            <li class="reveal">
              <div class="when">
                <strong>{job.dates}</strong>
                {job.title.includes("Intern") ? "Internship" : "Full time"}
              </div>
              <div class="role">
                <h3>{job.title}</h3>
                <p class="org">{job.org}</p>
                <ul>
                  {job.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Skills</p>
            <h2 id="skills-title">What I work with</h2>
          </div>
          <p>
            Grouped honestly: what I use every day, what I've shipped with, and
            what I'm still learning.
          </p>
        </div>
        <div class="skill-grid">
          {profile.skillGroups.map((group) => (
            <div
              class={`card skill-card reveal${group.title === "Currently learning" ? " learning" : ""}`}
            >
              <h3>{group.title}</h3>
              {group.note && <p class="level">{group.note}</p>}
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="education" aria-labelledby="education-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Background</p>
            <h2 id="education-title">Education and recognition</h2>
          </div>
        </div>
        <div class="edu-grid">
          <div class="card edu-card reveal">
            <h3>Education</h3>
            {profile.education.map((item) => (
              <div class="edu-item">
                <div class="top">
                  <h4>{item.degree}</h4>
                  <span class="dates">{item.dates}</span>
                </div>
                <p>{item.school}</p>
                <p>{item.detail}</p>
              </div>
            ))}
          </div>
          <div class="card edu-card reveal">
            <h3>Awards and certifications</h3>
            <ul class="awards">
              {profile.achievements.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="contact" aria-labelledby="contact-title">
      <div class="wrap contact-grid">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">Let's talk.</h2>
          <p>
            Questions about my work, a project, or a role? Send a message and I
            will reply by email.
          </p>
          <ul class="contact-list">
            <li>
              <span>Email</span>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
            </li>
            <li>
              <span>LinkedIn</span>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                bhargav-sai-bhartu
              </a>
            </li>
            <li>
              <span>GitHub</span>
              <a
                href={profile.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                ur24l
              </a>
            </li>
            <li>
              <span>Location</span>
              {profile.location}
            </li>
          </ul>
        </div>

        <div class="card form-card">
          <form
            id="contact-form"
            class="contact-form"
            data-endpoint={endpoint}
            data-is-webhook={profile.contactWebhookUrl ? "true" : "false"}
            data-owner-email={profile.email}
          >
            <input
              type="text"
              name="_honey"
              class="hp-field"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <div class="form-row">
              <div class="field">
                <label for="contact-name">Name</label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                />
              </div>
              <div class="field">
                <label for="contact-email">Email</label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                />
              </div>
            </div>
            <div class="field">
              <label for="contact-topic">Subject</label>
              <select id="contact-topic" name="topic">
                <option value="Job opportunity">Job opportunity</option>
                <option value="Project collaboration">
                  Project collaboration
                </option>
                <option value="General question">General question</option>
              </select>
            </div>
            <div class="field">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                rows={5}
                required
              ></textarea>
            </div>
            <p id="contact-error" class="form-error" role="alert" hidden></p>
            <div>
              <button class="button form-submit" type="submit">
                Send message
              </button>
            </div>
          </form>

          <div id="contact-success" class="form-success" hidden>
            <h3>Message sent</h3>
            <p id="contact-success-copy">Thank you. I will reply soon.</p>
            <button type="button" class="button secondary" id="contact-reset">
              Send another message
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<script>
  import "../scripts/contact";

  // Fade sections in as they scroll into view (skipped when motion is reduced).
  const items = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    items.forEach((el) => el.classList.add("is-visible"));
  }
</script>
