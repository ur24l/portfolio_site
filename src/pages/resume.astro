---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import profile from "../data/profile.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Résumé — Bhargav Sai Bhartu"
  description="Experience, projects, skills and education of Bhargav Sai Bhartu, Junior Software Developer at PHYTEC India."
>
  <div class="resume-toolbar">
    <a href={`${base}/`}>← Back to portfolio</a>
    <div>
      <a
        class="button button-dark"
        href={`${base}/assets/Bhargav-Sai-Bhartu-Resume.pdf`}
        download
      >
        Download PDF <Icon name="down" size={16} />
      </a>
      <a
        class="button button-outline"
        href={`${base}/assets/Bhargav-Sai-Bhartu-Resume.docx`}
        download
      >
        Word
      </a>
    </div>
  </div>
  <main id="main" class="resume-sheet">
    <header>
      <h1>{profile.name}</h1>
      <p class="resume-headline">Junior Software Developer</p>
      <p>
        {profile.location} ·{" "}
        <a href={`tel:${profile.phone.replace(/\s/g, "")}`}>{profile.phone}</a>{" "}
        · <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
      <p>
        <a href={profile.linkedin}>linkedin.com/in/bhargav-sai-bhartu</a> ·{" "}
        <a href={profile.github}>github.com/ur24l</a>
      </p>
    </header>
    <section>
      <h2>Professional Summary</h2>
      <p>{profile.summary}</p>
    </section>
    <section>
      <h2>Work Experience</h2>
      {profile.experience.map((job) => (
        <article>
          <div class="resume-row">
            <h3>{job.title}</h3>
            <span>{job.dates}</span>
          </div>
          <p>
            <strong>{job.org}</strong>
          </p>
          <ul>
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>
    <section>
      <h2>Skills and Current Learning</h2>
      {profile.skills.map(([category, items]) => (
        <p>
          <strong>{category}:</strong> {items}
        </p>
      ))}
    </section>
    <section>
      <h2>Selected Projects</h2>
      {profile.projects.map((project) => (
        <article>
          <h3>{project.name}</h3>
          <p class="resume-tech">{project.tech}</p>
          <ul>
            {project.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>
    <section>
      <h2>Education</h2>
      {profile.education.map((item) => (
        <article>
          <div class="resume-row">
            <h3>{item.degree}</h3>
            <span>{item.dates}</span>
          </div>
          <p>
            {item.school} · {item.detail}
          </p>
        </article>
      ))}
    </section>
    <section>
      <h2>Certifications and Achievements</h2>
      <ul>
        {profile.achievements.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </main>
  <style>
    .resume-toolbar {
      width: min(900px, 100% - 40px);
      margin: 30px auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      font-size: 12px;
    }
    .resume-toolbar > div {
      display: flex;
      gap: 10px;
    }
    .resume-sheet {
      width: min(900px, 100% - 40px);
      margin: 0 auto 50px;
      background: var(--paper);
      padding: 55px 60px;
      border: 1px solid var(--line);
      border-radius: 8px;
      font-size: 14px;
      line-height: 1.8;
    }
    .resume-sheet h1 {
      font-size: 32px;
      letter-spacing: -0.04em;
      line-height: 1.2;
    }
    .resume-sheet header > p {
      font-size: 12px;
      margin-top: 7px;
    }
    .resume-sheet header .resume-headline {
      font-size: 13px;
      margin: 10px 0;
    }
    .resume-sheet h2 {
      font-size: 17px;
      letter-spacing: 0;
      margin-bottom: 10px;
      font-weight: 600;
    }
    .resume-sheet section {
      margin-top: 32px;
    }
    .resume-sheet h3 {
      font-size: 14px;
      line-height: 1.6;
      font-weight: 600;
    }
    .resume-sheet article {
      margin-top: 14px;
    }
    .resume-sheet ul {
      list-style: disc;
      padding-left: 17px;
      margin-top: 5px;
    }
    .resume-sheet li {
      padding-left: 2px;
      margin-top: 3px;
    }
    .resume-sheet .resume-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }
    .resume-row > span {
      font-size: 11px;
      flex: none;
    }
    .resume-tech {
      font-size: 12px;
      color: var(--muted);
    }
    .resume-sheet a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    @media (max-width: 680px) {
      .resume-sheet {
        padding: 30px 23px;
      }
      .resume-sheet h1 {
        font-size: 28px;
      }
      .resume-sheet .resume-row {
        display: block;
      }
      .resume-toolbar .button {
        font-size: 10px;
        min-height: 40px;
        padding-inline: 12px;
        gap: 10px;
      }
      .resume-toolbar {
        font-size: 10px;
      }
    }
    @media print {
      .resume-toolbar {
        display: none;
      }
      .resume-sheet {
        width: 100%;
        padding: 0;
        border: 0;
        margin: 0;
        font-size: 10pt;
      }
      .resume-sheet h1 {
        font-size: 22pt;
      }
      .resume-sheet h2 {
        font-size: 12pt;
      }
      .resume-sheet section {
        margin-top: 12px;
      }
      .resume-sheet article {
        margin-top: 8px;
      }
      .resume-sheet h3 {
        font-size: 10pt;
      }
      .resume-sheet header > p,
      .resume-row > span {
        font-size: 9pt;
      }
      a {
        color: #111;
      }
      .resume-sheet .resume-row {
        display: flex;
      }
      @page {
        size: A4;
        margin: 15mm;
      }
    }
  </style>
</Layout>
