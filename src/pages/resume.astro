---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import profile from "../data/profile.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (file: string) => `${base}/assets/${file}`;
const linkText = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<Layout
  title="Resume · Bhargav Sai Bhartu"
  description="Resume of Bhargav Sai Bhartu, Junior Software Developer at PHYTEC India."
>
  <div class="screen-only">
    <SiteHeader />
    <div class="wrap resume-toolbar">
      <a class="button" href={asset("Bhargav-Sai-Bhartu-Resume.pdf")} download>
        Download PDF
      </a>
      <a
        class="button secondary"
        href={asset("Bhargav-Sai-Bhartu-Resume.docx")}
        download
      >
        Download Word
      </a>
    </div>
  </div>

  <main id="main" class="sheet">
    <header class="cv-header">
      <h1>{profile.name}</h1>
      <p class="cv-headline">{profile.headline}</p>
      <p class="cv-contact">
        <span>{profile.location}</span>
        <span>{profile.phone}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin}>{linkText(profile.linkedin)}</a>
        <a href={profile.github}>{linkText(profile.github)}</a>
      </p>
    </header>

    <section class="cv-section">
      <h2>Summary</h2>
      <p>{profile.summary}</p>
    </section>

    <section class="cv-section">
      <h2>Experience</h2>
      {profile.experience.map((job) => (
        <div class="cv-entry">
          <div class="cv-line">
            <p>
              <strong>{job.title}</strong>, {job.org}
            </p>
            <span>{job.dates}</span>
          </div>
          <ul>
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="cv-section">
      <h2>Projects</h2>
      {profile.projects.map((project) => (
        <div class="cv-entry">
          <p>
            <strong>{project.name}</strong>
            <span class="cv-tech"> | {project.tech}</span>
          </p>
          <ul>
            {project.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="cv-section">
      <h2>Skills</h2>
      <dl class="cv-skills">
        {profile.skills.map(([label, items]) => (
          <>
            <dt>{label}</dt>
            <dd>{items}</dd>
          </>
        ))}
      </dl>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      {profile.education.map((item) => (
        <div class="cv-line cv-entry">
          <p>
            <strong>{item.degree}</strong>, {item.school}
            <span class="cv-tech"> · {item.detail}</span>
          </p>
          <span>{item.dates}</span>
        </div>
      ))}
    </section>

    <section class="cv-section">
      <h2>Awards and certifications</h2>
      <ul>
        {profile.achievements.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </section>
  </main>

  <div class="screen-only">
    <SiteFooter />
  </div>

  <style>
    .resume-toolbar {
      display: flex;
      gap: 0.75rem;
      padding-top: 2rem;
      padding-bottom: 1.5rem;
    }
    .sheet {
      max-width: 210mm;
      margin: 0 auto 3rem;
      padding: 14mm 15mm;
      background: #fff;
      color: #111827;
      border: 1px solid var(--line);
      font-size: 10pt;
      line-height: 1.42;
    }
    .sheet a {
      color: #1d4f91;
    }
    .cv-header h1 {
      font-size: 21pt;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: #0f172a;
    }
    .cv-headline {
      margin-top: 2pt;
      font-size: 11pt;
      color: #374151;
    }
    .cv-contact {
      margin-top: 6pt;
      font-size: 9pt;
      color: #4b5563;
      display: flex;
      flex-wrap: wrap;
      gap: 0 10pt;
    }
    .cv-section {
      border: 0;
      padding: 0;
      margin-top: 11pt;
    }
    .cv-section h2 {
      font-size: 9pt;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #1d4f91;
      padding-bottom: 3pt;
      margin-bottom: 6pt;
      border-bottom: 1px solid #d1d5db;
    }
    .cv-entry + .cv-entry {
      margin-top: 6pt;
    }
    .cv-line {
      display: flex;
      justify-content: space-between;
      gap: 12pt;
      align-items: baseline;
    }
    .cv-line > span {
      white-space: nowrap;
      color: #4b5563;
      font-size: 9.5pt;
    }
    .cv-tech {
      color: #6b7280;
      font-size: 9.5pt;
    }
    .sheet ul {
      margin-top: 2pt;
      padding-left: 13pt;
    }
    .sheet li + li {
      margin-top: 1.5pt;
    }
    .cv-skills {
      display: grid;
      grid-template-columns: 34mm 1fr;
      gap: 2pt 8pt;
      margin: 0;
    }
    .cv-skills dt {
      font-weight: 600;
    }
    .cv-skills dd {
      margin: 0;
    }
    @media (max-width: 640px) {
      .sheet {
        padding: 1.25rem;
        border-left: 0;
        border-right: 0;
      }
      .cv-line {
        flex-direction: column;
        gap: 0;
      }
      .cv-skills {
        grid-template-columns: 1fr;
      }
      .cv-skills dd {
        margin-bottom: 4pt;
      }
    }
    :global(:root[data-theme="dark"]) .sheet {
      border-color: #262a31;
    }
    @page {
      size: A4;
      margin: 0;
    }
    @media print {
      .screen-only,
      .skip-link {
        display: none !important;
      }
      body {
        background: #fff;
      }
      .sheet {
        border: 0;
        margin: 0;
        max-width: none;
        width: 210mm;
      }
      .sheet {
        padding: 11mm 15mm 9mm;
      }
      .cv-section {
        margin-top: 9pt;
      }
    }
  </style>
</Layout>
