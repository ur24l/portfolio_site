{
  "name": "bhargav-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/check_output.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests *.mjs *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "astro": "7.4.0",
    "motion": "14.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
